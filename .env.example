# =============================================================
# Order Platform Configuration
# =============================================================
# Copy this file to .env and adjust values for your environment.

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://orderplatform:orderplatform_dev@localhost:5432/order_platform

# Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=debug

# Notification Simulation
NOTIFICATION_DELAY_MS=500
NOTIFICATION_FAILURE_RATE=0.0

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=order-platform
KAFKA_CONSUMER_GROUP_ID=notification-service
KAFKA_TOPIC_ORDER_EVENTS=order-events

# Dead Letter Queue
KAFKA_TOPIC_DLQ=order-events-dlq

# Consumer Retry
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BASE_DELAY_MS=1000

# Outbox Relay
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# Redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=op:

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Cache
CACHE_ORDER_TTL_SECONDS=60

# Leader Election
LEADER_ELECTION_LEASE_TTL_MS=15000
LEADER_ELECTION_HEARTBEAT_MS=5000

# SSE / Realtime
SSE_HEARTBEAT_INTERVAL_MS=15000
SSE_MAX_CONNECTIONS_PER_ORDER=10
SSE_MAX_TOTAL_CONNECTIONS=1000
SSE_BACKPRESSURE_HIGH_WATER_MARK=65536
SSE_BACKPRESSURE_CRITICAL_MARK=262144
SSE_CLIENT_RETRY_MS=3000

# Metrics / Observability
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Consumer metrics port (scraped by Prometheus)
CONSUMER_METRICS_PORT=9464

# Graceful Shutdown
SHUTDOWN_TIMEOUT_MS=10000